{
  "manifest_version": 3,
  "name": "Netflix Japanese Word-Order Studio (일본어 어순 받아쓰기)",
  "version": "1.1.1",
  "description": "넷플릭스 일드·애니 시청 중 대사별 자동 멈춤, 섞인 일본어 단어 블록 순서 맞추기, 단어·문법 해설 및 노션(Notion) 실시간 자동 단어장 연동을 제공합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.nflxvideo.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Netflix 일본어 어순 받아쓰기 설정 & 학습장",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["early_shield.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["injected_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["analyzer_jp.js", "content_ui.js"],
      "css": ["netflix_page.css"],
      "run_at": "document_idle"
    }
  ]
}

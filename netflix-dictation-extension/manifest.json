{
  "manifest_version": 3,
  "name": "Netflix Sitcom Dictation Studio (미드 영어 받아쓰기)",
  "version": "1.2.1",
  "description": "넷플릭스 미드 시청 중 대사별 자동 일시정지, 구간 반복 받아쓰기, 한·영 자막 매칭, 숙어·문법 해설 및 노션(Notion) 실시간 자동 단어장 연동을 제공합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.nflxvideo.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Netflix Dictation Studio 설정 & 단어장",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["early_shield.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["injected_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["analyzer_dict.js", "content_ui.js"],
      "css": ["netflix_page.css"],
      "run_at": "document_idle"
    }
  ]
}
